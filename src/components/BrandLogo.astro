---
import { BRAND_LOGO_ALT, BRAND_LOGO_MASTER } from '../config/brand';

interface Props {
  /** Rendered CSS pixel size (width and height). */
  size?: number;
  class?: string;
  /** Header / above-the-fold: eager load, no lazy. */
  priority?: boolean;
}

const { size = 32, class: className, priority = false } = Astro.props;

---

<img src={BRAND_LOGO_MASTER} alt={BRAND_LOGO_ALT} width={size} height={size} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} class={className} />
